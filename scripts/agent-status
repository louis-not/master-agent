#!/usr/bin/env bash
# agent-status — at-a-glance view of the multi-agent orchestrator.
#
# Prints:
#   - board: card counts per kanban column + slugs of in-flight cards
#   - sessions: live tmux agent-* sessions and their uptime
#   - sentinels: latest sentinel per component (STATUS + SUMMARY + mtime)
#   - change_logs: head entry of each component's change_logs.md
#
# Usage:
#   agent-status                       # auto-discover paths from script location
#   agent-status --project-root <dir>  # override project root
#   agent-status --help

set -euo pipefail

# ---- args -------------------------------------------------------------------

PROJECT_ROOT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --project-root) PROJECT_ROOT="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# ---- path discovery ---------------------------------------------------------
# Script lives at <orchestrator>/scripts/agent-status. Orchestrator root is one
# level up. Project root is one level above the orchestrator unless overridden.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ORCH_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [ -z "$PROJECT_ROOT" ]; then
  PROJECT_ROOT="$(cd "$ORCH_ROOT/.." && pwd)"
fi

BOARD="$ORCH_ROOT/board.md"

# ---- colors -----------------------------------------------------------------

if [ -t 1 ]; then
  C_DIM='\033[2m'; C_BOLD='\033[1m'; C_OK='\033[0;32m'; C_WARN='\033[0;33m'; C_BAD='\033[0;31m'; C_RESET='\033[0m'
else
  C_DIM=''; C_BOLD=''; C_OK=''; C_WARN=''; C_BAD=''; C_RESET=''
fi

status_color() {
  case "$1" in
    done|pass|approve) printf '%s' "$C_OK" ;;
    block|fail)        printf '%s' "$C_BAD" ;;
    *)                 printf '%s' "$C_WARN" ;;
  esac
}

hr() { printf '%s%s%s\n' "$C_DIM" "----------------------------------------" "$C_RESET"; }

# ---- board ------------------------------------------------------------------

print_board() {
  printf '%s[board]%s  %s\n' "$C_BOLD" "$C_RESET" "$BOARD"
  if [ ! -f "$BOARD" ]; then
    printf '  %s(no board.md found)%s\n' "$C_WARN" "$C_RESET"; return
  fi

  # Parse: column = "## <Name>"; card = "### <slug>"; assign cards to the
  # most recent column heading seen.
  awk '
    /^## / { col = substr($0, 4); counts[col] = counts[col] + 0; next }
    /^### / { slug = substr($0, 5); counts[col]++; cards[col] = cards[col] " " slug }
    END {
      n = split("Plan Develop Test\\ &\\ Review Ship Done Blocked", order, " ")
      for (i = 1; i <= n; i++) {
        c = order[i]; gsub(/\\ /, " ", c)
        printf "  %-14s %d\n", tolower(c) ":", counts[c]
        if (counts[c] > 0 && c != "Done") {
          printf "  %-14s%s\n", "", cards[c]
        }
      }
    }
  ' "$BOARD"
}

# ---- sessions ---------------------------------------------------------------

print_sessions() {
  printf '\n%s[sessions]%s\n' "$C_BOLD" "$C_RESET"
  if ! command -v tmux >/dev/null 2>&1; then
    printf '  %s(tmux not installed)%s\n' "$C_WARN" "$C_RESET"; return
  fi
  local out
  out=$( { tmux list-sessions -F '#{session_name}|#{session_created}' 2>/dev/null || true; } \
         | awk -F'|' '$1 ~ /^agent-/ { print }')
  if [ -z "$out" ]; then
    printf '  %s(no agent-* sessions alive)%s\n' "$C_DIM" "$C_RESET"; return
  fi
  local now; now=$(date +%s)
  while IFS='|' read -r name created; do
    local age=$(( now - created ))
    local d=$(( age / 86400 ))
    local h=$(( (age % 86400) / 3600 ))
    local m=$(( (age % 3600) / 60 ))
    printf '  %-22s up %dd %02dh %02dm\n' "$name" "$d" "$h" "$m"
  done <<< "$out"
}

# ---- sentinels --------------------------------------------------------------

# Read a value from sentinel file. Supports plain `KEY=value` and
# `KEY=<<<` ... `>>>` multi-line fences. Prints up to N lines.
read_sentinel_value() {
  local file=$1 key=$2 maxlines=${3:-2}
  awk -v k="$key" -v max="$maxlines" '
    BEGIN { in_fence = 0; printed = 0 }
    in_fence == 1 {
      if ($0 == ">>>") { in_fence = 0; next }
      if (printed < max) { print; printed++ }
      next
    }
    $0 ~ "^" k "=<<<" { in_fence = 1; next }
    $0 ~ "^" k "=" {
      v = substr($0, length(k) + 2)
      print v
      exit
    }
  ' "$file"
}

print_sentinels() {
  printf '\n%s[sentinels]%s\n' "$C_BOLD" "$C_RESET"
  local files
  files=$(find "$PROJECT_ROOT" -type f -path '*/memory/.ready-*' 2>/dev/null | sort)
  if [ -z "$files" ]; then
    printf '  %s(no sentinels found under %s)%s\n' "$C_DIM" "$PROJECT_ROOT" "$C_RESET"; return
  fi
  while IFS= read -r f; do
    local rel="${f#$PROJECT_ROOT/}"
    local status summary mtime pane_input
    status=$(read_sentinel_value "$f" STATUS 1)
    summary=$(read_sentinel_value "$f" SUMMARY 1)
    pane_input=$(read_sentinel_value "$f" USER_PANE_INPUT 3)
    mtime=$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null || stat -c '%y' "$f" | cut -c1-16)
    local sc; sc=$(status_color "$status")
    printf '  %-42s %sSTATUS=%-7s%s %s\n' "$rel" "$sc" "$status" "$C_RESET" "$mtime"
    [ -n "$summary" ] && printf '  %-42s %ssummary:%s %s\n' "" "$C_DIM" "$C_RESET" "$summary"
    # Surface direct pane interventions prominently — they are the user's own input
    # and should not get lost in the noise.
    if [ -n "$pane_input" ] && [ "$pane_input" != "none" ] && [ "$pane_input" != "- none" ]; then
      while IFS= read -r line; do
        [ -z "$line" ] && continue
        printf '  %-42s %suser-pane:%s %s\n' "" "$C_WARN" "$C_RESET" "$line"
      done <<< "$pane_input"
    fi
  done <<< "$files"
}

# ---- change logs ------------------------------------------------------------

print_changelogs() {
  printf '\n%s[change_logs]%s (head entry)\n' "$C_BOLD" "$C_RESET"
  local files
  files=$(find "$PROJECT_ROOT" -type f -path '*/memory/change_logs.md' 2>/dev/null | sort)
  if [ -z "$files" ]; then
    printf '  %s(no change_logs.md found under %s)%s\n' "$C_DIM" "$PROJECT_ROOT" "$C_RESET"; return
  fi
  while IFS= read -r f; do
    local rel="${f#$PROJECT_ROOT/}"
    printf '  %s\n' "$rel"
    # Print the first "## " entry block: heading + up to 6 following lines that
    # are bullets or blank. Stops at next "## " or after 6 body lines.
    awk '
      /^## / { if (seen) exit; seen = 1; print "    " $0; lines = 0; next }
      seen && /^## / { exit }
      seen && lines < 6 { print "    " $0; lines++ }
    ' "$f" || true
    echo
  done <<< "$files"
}

# ---- main -------------------------------------------------------------------

printf '%sagent-status%s  project_root=%s\n' "$C_BOLD" "$C_RESET" "$PROJECT_ROOT"
hr
print_board
print_sessions
print_sentinels
print_changelogs
